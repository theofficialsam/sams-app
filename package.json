{
  "name": "sams-app",
  "version": "1.0.0",
  "description": "S.A.M.S — Scholastic Attendance Management System. A single-file offline-first attendance app for Android (Capacitor) and browser/PWA.",
  "main": "index.html",
  "scripts": {
    "open:android": "npx cap open android",
    "sync": "npx cap sync",
    "build:android": "npx cap sync android && npx cap open android",
    "serve": "npx serve . -p 3000"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "serve": "^14.0.0"
  },
  "keywords": [
    "attendance",
    "school",
    "capacitor",
    "android",
    "pwa",
    "offline",
    "indexeddb"
  ],
  "author": "SAM",
  "license": "MIT"
}
